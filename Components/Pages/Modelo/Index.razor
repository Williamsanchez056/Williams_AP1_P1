@page "/autores"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.AspNetCore.Components.Forms
@using Williams_AP1_P1.Context
@using Williams_AP1_P1.Models

@inject Williams_AP1_P1.Services.AutorService autorService

@rendermode InteractiveServer

<PageTitle>Autores</PageTitle>

<div class="container mt-4">
    <div class="card p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Lista de Autores</h3>

            <button class="btn btn-primary" @onclick="AbrirModalNuevo">
                Nuevo
            </button>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <select class="form-select" @bind="filtro">
                    <option value="">-- Filtrar por --</option>
                    <option value="Nombres">Nombres</option>
                    <option value="Nacionalidad">Nacionalidad</option>
                </select>
            </div>

            <div class="col-md-4">
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           placeholder="Escribe para buscar tu autor preferido"
                           @bind="textoBusqueda" />

                    <button class="btn btn-primary" @onclick="Buscar">
                        Buscar
                    </button>
                </div>
            </div>
        </div>

        <QuickGrid Items="listaMostrar.AsQueryable()"
                   class="table table-bordered">

            <PropertyColumn Property="a => a.IdAutor"
                            Title="Id" />

            <PropertyColumn Property="a => a.Nombre"
                            Title="Nombres" />

            <PropertyColumn Property="a => a.Nacionalidad"
                            Title="Nacionalidad" />

            <TemplateColumn Title="Fecha Nacimiento">
                @context.FechaNacimiento.ToString("dd/MM/yyyy")
            </TemplateColumn>

            <PropertyColumn Property="a => a.Sueldo"
                            Title="Sueldo" />

            <TemplateColumn Title="Acciones">
                <button class="btn btn-sm btn-warning me-1"
                        @onclick="() => AbrirModalEditar(context.IdAutor)">
                    Editar
                </button>

                <button class="btn btn-sm btn-danger"
                        @onclick="() => Eliminar(context.IdAutor)">
                    Eliminar
                </button>
            </TemplateColumn>
        </QuickGrid>

        <div class="mt-3">
            <p class="text-muted">
                Total de autores: @listaMostrar.Count
            </p>

            <p class="text-muted">
                Total de sueldos: @listaMostrar.Sum(x => x.Sueldo).ToString("C2")
            </p>
        </div>
    </div>
</div>

@* Modal para crear o editar *@
@if (mostrarModal)
{
    <div class="modal d-block" tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(modelo.IdAutor == 0 ? "Nuevo Autor" : "Editar Autor")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            aria-label="Cerrar"
                            @onclick="CerrarModal">
                    </button>
                </div>

                <div class="modal-body">
                    <EditForm Model="modelo" OnValidSubmit="GuardarModelo">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>

                            <InputText class="form-control"
                                       @bind-Value="modelo.Nombre" />

                            <ValidationMessage For="@(() => modelo.Nombre)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nacionalidad</label>

                            <InputText class="form-control"
                                       @bind-Value="modelo.Nacionalidad" />

                            <ValidationMessage For="@(() => modelo.Nacionalidad)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fecha de Nacimiento</label>

                            <InputDate class="form-control"
                                       @bind-Value="modelo.FechaNacimiento" />

                            <ValidationMessage For="@(() => modelo.FechaNacimiento)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Sueldo</label>

                            <InputNumber class="form-control"
                                         @bind-Value="modelo.Sueldo" />

                            <ValidationMessage For="@(() => modelo.Sueldo)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-secondary"
                                    @onclick="CerrarModal">
                                Cancelar
                            </button>

                            <button type="submit" class="btn btn-primary">
                                Guardar
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Autor> listaCompleta = new();
    private List<Autor> listaMostrar = new();

    private string filtro = "";
    private string textoBusqueda = "";

    private bool mostrarModal = false;
    private Autor modelo = new Autor();

    protected override async Task OnInitializedAsync()
    {
        await Actualizar();
    }

    private async Task Actualizar()
    {
        listaCompleta = await autorService.Listar(a => true);
        Buscar();
    }

    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            listaMostrar = listaCompleta;
            return;
        }

        if (filtro == "Nombres")
        {
            listaMostrar = listaCompleta
                .Where(x => (x.Nombre ?? "")
                    .Contains(textoBusqueda.Trim(),
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else if (filtro == "Nacionalidad")
        {
            listaMostrar = listaCompleta
                .Where(x => (x.Nacionalidad ?? "")
                    .Contains(textoBusqueda.Trim(),
                        StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else
        {
            listaMostrar = listaCompleta;
        }
    }

    private async Task Eliminar(int id)
    {
        var eliminado = await autorService.Eliminar(id);

        if (eliminado)
        {
            await Actualizar();
        }
    }

    private void AbrirModalNuevo()
    {
        modelo = new Autor();
        mostrarModal = true;
    }

    private async Task AbrirModalEditar(int id)
    {
        var encontrado = await autorService.Buscar(id);

        if (encontrado != null)
        {
            modelo = encontrado;
            mostrarModal = true;
        }
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarModelo()
    {
        var guardado = await autorService.Guardar(modelo);

        if (guardado)
        {
            mostrarModal = false;
            await Actualizar();
        }
    }
}
