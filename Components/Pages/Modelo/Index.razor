@page "/autores"

@using Microsoft.AspNetCore.Components.QuickGrid
@using Williams_AP1_P1.Models
@using Williams_AP1_P1.Services

@inject AutorService autorService

<PageTitle>Registro de autores</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center mb-4">
            <h5 class="card-title">Registro de autores</h5>

            <a href="/autores/create" class="btn btn-primary">
                <i class="bi bi-plus-square"></i> Crear
            </a>
        </div>

        <div class="card-body">

            <div class="row">
                <div class="col-3">
                    <label class="col-form-label">
                        <strong>Filtrar por</strong>
                    </label>
                </div>

                <div class="col-4">
                    <label class="col-form-label">
                        <strong>Búsqueda</strong>
                    </label>
                </div>
            </div>

            <div class="row align-items-center mb-3">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" disabled>Elija una opción</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Nacionalidad">Nacionalidad</option>
                    </InputSelect>
                </div>

                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control"
                               @bind="ValorFiltro"
                               placeholder="Buscar" />

                        <button type="button"
                                class="btn btn-outline-primary"
                                @onclick="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <QuickGrid Items="@AutorQueryable"
                           class="table table-hover table-striped">

                    <PropertyColumn Property="@(a => a.IdAutor)"
                                    Title="AutorId"
                                    Sortable="true" />

                    <PropertyColumn Property="@(a => a.Nombre)"
                                    Title="Nombre"
                                    Sortable="true" />

                    <PropertyColumn Property="@(a => a.Nacionalidad)"
                                    Title="Nacionalidad"
                                    Sortable="true" />

                    <PropertyColumn Property="@(a => a.FechaNacimiento)"
                                    Title="FechaNacimiento"
                                    Format="dd/MM/yyyy"
                                    Sortable="true" />

                    <PropertyColumn Property="@(a => a.Sueldo)"
                                    Title="Sueldo"
                                    Sortable="true" />

                    <TemplateColumn Title="Opciones"
                                    Align="Align.Center">
                        <a href="@($"/autores/edit/{context.IdAutor}")"
                           class="btn btn-outline-primary">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </TemplateColumn>

                </QuickGrid>
            </div>

            <div class="card-footer d-flex justify-content-between align-items-center">
                <label class="mb-0">
                    Cantidad: @ListaAutores.Count
                </label>

                <label class="mb-0">
                    Total acumulado: @ListaAutores.Sum(a => a.Sueldo).ToString("N2")
                </label>
            </div>

        </div>
    </div>
</div>

@code {
    public List<Autor> ListaAutores { get; set; } = new();

    private IQueryable<Autor> AutorQueryable =
        Enumerable.Empty<Autor>().AsQueryable();

    public string Filtro { get; set; } = string.Empty;

    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaAutores = await autorService.GetList(a => true);

        AutorQueryable = ListaAutores.AsQueryable();
    }

    public async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(ValorFiltro))
        {
            ListaAutores = await autorService.GetList(a => true);
        }
        else if (Filtro == "Nombre")
        {
            string busqueda = ValorFiltro.Trim().ToLower();

            ListaAutores = await autorService.GetList(
                a => a.Nombre.ToLower().Contains(busqueda));
        }
        else if (Filtro == "Nacionalidad")
        {
            string busqueda = ValorFiltro.Trim().ToLower();

            ListaAutores = await autorService.GetList(
                a => a.Nacionalidad.ToLower().Contains(busqueda));
        }
        else
        {
            ListaAutores = await autorService.GetList(a => true);
        }

        AutorQueryable = ListaAutores.AsQueryable();
    }
}
