@page "/autores/create"
@using Williams_AP1_P1.Models
@using Williams_AP1_P1.Services
@using Blazored.Toast.Services

@inject AutorService autorService
@inject NavigationManager navigationManager
@inject IToastService toastService

<PageTitle>Crear Autor</PageTitle>

<EditForm Model="autor" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Crear Autor</h5>
            </div>

            <div class="card-body">
                <div class="mt-3">
                    <label class="form-label">
                        <strong>Nombre</strong>
                    </label>

                    <InputText class="form-control"
                               @bind-Value="autor.Nombre" />

                    <ValidationMessage For="@(() => autor.Nombre)" />
                </div>

                <div class="mt-3">
                    <label class="form-label">
                        <strong>Nacionalidad</strong>
                    </label>

                    <InputText class="form-control"
                               @bind-Value="autor.Nacionalidad" />

                    <ValidationMessage For="@(() => autor.Nacionalidad)" />
                </div>

                <div class="mt-3">
                    <label class="form-label">
                        <strong>Fecha de nacimiento</strong>
                    </label>

                    <InputDate class="form-control"
                               @bind-Value="autor.FechaNacimiento" />

                    <ValidationMessage For="@(() => autor.FechaNacimiento)" />
                </div>

                <div class="mt-3">
                    <label class="form-label">
                        <strong>Sueldo</strong>
                    </label>

                    <InputNumber class="form-control"
                                 @bind-Value="autor.Sueldo" />

                    <ValidationMessage For="@(() => autor.Sueldo)" />
                </div>
            </div>

            <div class="card-footer text-center">
                <a href="/autores" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left"></i>
                    Volver
                </a>

                <button type="submit"
                        class="btn btn-primary m-2"
                        disabled="@guardando">
                    <i class="bi bi-floppy"></i>
                    @(guardando ? "Guardando.":"Guardar")
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Autor autor { get; set; } = new();

    private bool guardando;

    public async Task Guardar()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            autor.Nombre = autor.Nombre.Trim();

            var existeNombre = await autorService.GetList(
                a => a.Nombre.ToLower() == autor.Nombre.ToLower());

            if (existeNombre.Any())
            {
                toastService.ShowWarning(
                    "Ya existe un autor con ese nombre.");

                return;
            }

            var creado = await autorService.Guardar(autor);

            if (creado)
            {
                toastService.ShowSuccess(
                    "Autor creado correctamente.");

                navigationManager.NavigateTo("/autores");
            }
            else
            {
                toastService.ShowError(
                    "No se pudo crear el autor.");
            }
        }
        catch (Exception)
        {
            toastService.ShowError(
                "Ocurrio un error al crear el autor.");
        }
        finally
        {
            guardando = false;
        }
    }
}
