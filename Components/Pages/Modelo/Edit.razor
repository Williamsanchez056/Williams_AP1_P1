@page "/autores/edit/{Id:int}"

@using Williams_AP1_P1.Models
@using Blazored.Toast.Services

@inject IServiceResult<Autor, int> autorService
@inject NavigationManager navigationManager
@inject IToastService toastService

<PageTitle>Modificar Autor</PageTitle>

@if (cargando)
{
    <p>Cargando autor...</p>
}
else if (autorCargado)
{
    <EditForm Model="autor" OnValidSubmit="Modificar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="container">
            <div class="card shadow-lg">
                <div class="card-header text-center">
                    <h5 class="card-title">Modificar Autor</h5>
                </div>

                <div class="card-body">
                    <div class="mt-3">
                        <label class="form-label"><strong>Nombre</strong></label>
                        <InputText class="form-control" @bind-Value="autor.Nombre" />
                        <ValidationMessage For="@(() => autor.Nombre)" />
                    </div>

                    <div class="mt-3">
                        <label class="form-label"><strong>Nacionalidad</strong></label>
                        <InputText class="form-control" @bind-Value="autor.Nacionalidad" />
                        <ValidationMessage For="@(() => autor.Nacionalidad)" />
                    </div>

                    <div class="mt-3">
                        <label class="form-label"><strong>Fecha de nacimiento</strong></label>
                        <InputDate class="form-control" @bind-Value="autor.FechaNacimiento" />
                        <ValidationMessage For="@(() => autor.FechaNacimiento)" />
                    </div>

                    <div class="mt-3">
                        <label class="form-label"><strong>Sueldo</strong></label>
                        <InputNumber class="form-control" @bind-Value="autor.Sueldo" />
                        <ValidationMessage For="@(() => autor.Sueldo)" />
                    </div>
                </div>

                <div class="card-footer text-center">
                    <a href="/autores" class="btn btn-secondary ms-2">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>

                    <button type="submit"
                            class="btn btn-primary m-2"
                            disabled="@guardando">
                        <i class="bi bi-floppy"></i>
                        Guardar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="MostrarConfirmacion"
                            disabled="@guardando">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                </div>
            </div>
        </div>
    </EditForm>
}
else
{
    <div class="alert alert-warning" role="alert">
        No se pudo cargar el autor.
        <a href="/autores">Volver al listado</a>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal show d-block" tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminacion</h5>
                    <button type="button"
                            class="btn-close"
                            @onclick="CancelarEliminacion"
                            aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    Esta seguro de que desea eliminar este autor?
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelarEliminacion">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="EliminarAutor"
                            disabled="@guardando">
                        Confirmar eliminacion
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Autor autor { get; set; } = new();

    private bool guardando;
    private bool cargando = true;
    private bool autorCargado;
    private bool mostrarConfirmacion;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        autorCargado = false;

        try
        {
            var resultado = await autorService.Buscar(Id);

            if (resultado.IsFailure)
            {
                toastService.ShowError(resultado.Error.Description);
                navigationManager.NavigateTo("/autores");
                return;
            }

            if (resultado.Value is null)
            {
                toastService.ShowError("No se encontro el autor.");
                navigationManager.NavigateTo("/autores");
                return;
            }

            autor = resultado.Value;
            autorCargado = true;
        }
        catch (Exception)
        {
            toastService.ShowError(
                "Ocurrio un error al cargar el autor.");

            navigationManager.NavigateTo("/autores");
        }
        finally
        {
            cargando = false;
        }
    }

    public async Task Modificar()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            autor.Nombre = autor.Nombre.Trim();
            autor.Nacionalidad = autor.Nacionalidad.Trim();

            var consulta = await autorService.GetList(
                a => a.Nombre.ToLower() == autor.Nombre.ToLower()
                     && a.IdAutor != autor.IdAutor);

            if (consulta.IsFailure)
            {
                toastService.ShowError(consulta.Error.Description);
                return;
            }

            if (consulta.Value.Any())
            {
                toastService.ShowWarning(
                    "Ya existe otro autor con ese nombre.");
                return;
            }

            var resultado = await autorService.Guardar(autor);

            if (resultado.IsSuccess)
            {
                toastService.ShowSuccess(
                    "Autor modificado correctamente.");

                navigationManager.NavigateTo("/autores");
            }
            else
            {
                toastService.ShowError(resultado.Error.Description);
            }
        }
        catch (Exception)
        {
            toastService.ShowError(
                "Ocurrio un error inesperado al modificar el autor.");
        }
        finally
        {
            guardando = false;
        }
    }

    public void MostrarConfirmacion()
    {
        mostrarConfirmacion = true;
    }

    public void CancelarEliminacion()
    {
        mostrarConfirmacion = false;
    }

    public async Task EliminarAutor()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            var resultado = await autorService.Eliminar(Id);

            if (resultado.IsSuccess)
            {
                toastService.ShowSuccess(
                    "Autor eliminado correctamente.");

                navigationManager.NavigateTo("/autores");
            }
            else
            {
                toastService.ShowError(resultado.Error.Description);
                mostrarConfirmacion = false;
            }
        }
        catch (Exception)
        {
            toastService.ShowError(
                "Ocurrio un error inesperado al eliminar el autor.");

            mostrarConfirmacion = false;
        }
        finally
        {
            guardando = false;
        }
    }
}
