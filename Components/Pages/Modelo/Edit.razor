@page "/autores/edit/{Id:int}"

@using Williams_AP1_P1.Context
@using Williams_AP1_P1.Models
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

@rendermode InteractiveServer

<PageTitle>Editar</PageTitle>

<div class="container mt-4">

    <div class="card p-4 col-md-6 mx-auto">
        <h4>Editar Autor</h4>
        <div class="mb-3">
            <label>Id:</label>
            <input class="form-control"
                   value="@autor.IdAutor"
                   disabled />
        </div>
        <div class="mb-3">

            <label>Nombre:</label>

            <Component />

        </div>
        <div class="mb-3">

            <label>Nacionalidad:</label>
            <input class="form-control"
                   @bind="autor.Nacionalidad" />

        </div>
        <div class="mb-3">

            <label>Fecha de Nacimiento:</label>

            <InputDate @bind-Value="autor.FechaNacimiento" class="form-control" />

        </div>
        <div class="mb-3">

            <label>Sueldo:</label>

            <input type="number"
                   class="form-control"
                   @bind="autor.Sueldo" />

        </div>
        <div class="d-flex gap-2">

            <button class="btn btn-primary"
                    @onclick="Guardar">

                Guardar Cambios
            </button>

            <a href="/autores"
               class="btn btn-secondary">

                Volver

            </a>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int Id { get; set; }

    private Autor autor = new();

    protected override async Task OnInitializedAsync()
    {
        var db = await DbFactory.CreateDbContextAsync();

        var encontrado = await db.Autores.FindAsync(Id);

        if (encontrado != null)
        {
            autor = encontrado;
            autor.FechaNacimiento = autor.FechaNacimiento.Date;
        }
    }

    private async Task Guardar()
    {
        var db = await DbFactory.CreateDbContextAsync();

        autor.FechaNacimiento = autor.FechaNacimiento.Date;

        db.Autores.Update(autor);

        await db.SaveChangesAsync();

        Navigation.NavigateTo("/autores");
    }

}