@page "/autores/edit/{Id:int}"

@using Williams_AP1_P1.Models
@using Williams_AP1_P1.Services

@inject AutorService autorService
@inject NavigationManager navigationManager

<PageTitle>Modificar Autor</PageTitle>

<EditForm Model="autor" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">

            <div class="card-header text-center">
                <h5 class="card-title">Modificar Autor</h5>
            </div>

            <div class="card-body">

                <div class="mt-3">
                    <label class="form-label"><strong>Nombre</strong></label>
                    <InputText class="form-control" @bind-Value="autor.Nombre" />
                    <ValidationMessage For="@(() => autor.Nombre)" />
                </div>

                <div class="mt-3">
                    <label class="form-label"><strong>Nacionalidad</strong></label>
                    <InputText class="form-control" @bind-Value="autor.Nacionalidad" />
                    <ValidationMessage For="@(() => autor.Nacionalidad)" />
                </div>

                <div class="mt-3">
                    <label class="form-label"><strong>Fecha de nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="autor.FechaNacimiento" />
                    <ValidationMessage For="@(() => autor.FechaNacimiento)" />
                </div>

                <div class="mt-3">
                    <label class="form-label"><strong>Sueldo</strong></label>
                    <InputNumber class="form-control" @bind-Value="autor.Sueldo" />
                    <ValidationMessage For="@(() => autor.Sueldo)" />
                </div>

            </div>

            <div class="card-footer text-center">
                <a href="/autores" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>

                <button type="submit" class="btn btn-primary m-2"
                        disabled="@guardando">
                    <i class="bi bi-floppy"></i>
                    Guardar
                </button>

                <button type="button" class="btn btn-danger"
                        @onclick="MostrarConfirmacion">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </div>

        </div>
    </div>
</EditForm>

@if (mostrarConfirmacion)
{
    <div class="modal show d-block" tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close"
                            @onclick="CancelarEliminacion"></button>
                </div>

                <div class="modal-body">
                    ¿Está seguro de que desea eliminar este autor?
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            @onclick="CancelarEliminacion">
                        Cancelar
                    </button>

                    <button type="button" class="btn btn-danger"
                            @onclick="EliminarAutor"
                            disabled="@guardando">
                        Confirmar eliminación
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Autor autor { get; set; } = new();

    private bool guardando;
    private bool mostrarConfirmacion;

    protected override async Task OnInitializedAsync()
    {
        var encontrado = await autorService.Buscar(Id);

        if (encontrado is null)
        {
            navigationManager.NavigateTo("/autores");
            return;
        }

        autor = encontrado;
    }

    public async Task Modificar()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            autor.Nombre = autor.Nombre.Trim();

            var ExisteNombre = await autorService.GetList(
                a => a.Nombre.ToLower() == autor.Nombre.ToLower()
                     && a.IdAutor != autor.IdAutor);

            if (ExisteNombre.Any())
            {
                guardando = false;
                return;
            }

            var Modificado = await autorService.Guardar(autor);

            if (Modificado)
            {
                navigationManager.NavigateTo("/autores");
            }
            else
            {
                guardando = false;
            }
        }
        catch (Exception)
        {
            guardando = false;
        }
    }

    public void MostrarConfirmacion()
    {
        mostrarConfirmacion = true;
    }

    public void CancelarEliminacion()
    {
        mostrarConfirmacion = false;
    }

    public async Task EliminarAutor()
    {
        if (guardando)
            return;

        guardando = true;

        try
        {
            var Eliminado = await autorService.Eliminar(Id);

            if (Eliminado)
            {
                navigationManager.NavigateTo("/autores");
            }
            else
            {
                guardando = false;
                mostrarConfirmacion = false;
            }
        }
        catch (Exception)
        {
            guardando = false;
            mostrarConfirmacion = false;
        }
    }
}
